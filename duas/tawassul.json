[
  {
    "id": 1,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ وَأَتَوَجَّهُ إِلَيْكَ",
    "englishText": "O Allah, I beseech You and turn my face toward You"
  },
  {
    "id": 2,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "بِنَبِيِّكَ نَبِيِّ ٱلرَّحْمَةِ",
