[
  {
    "id": 1,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ سَيِّدِ ٱلْمُرْسَلِينَ",
    "englishText": "O Allah, (please) send blessings to Muhammad, the master of the messengers (of Allah),"
  },
  {
    "id": 2,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخَاتَمِ ٱلنَّبِيِّينَ",
    "englishText": "the seal of the Prophets,"
  },
  {
    "id": 3,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the Argument of the Lord of the worlds [against His creatures]"
  },
  {
    "id": 4,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُنْتَجَبِ فِي ٱلْمِيثَاقِ",
    "englishText": "who had been elected [for Prophethood] since the Covenant"
  },
  {
    "id": 5,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُصْطَفَىٰ فِي ٱلظِّلاَلِ",
    "englishText": "and chosen since the World of Shadows,"
  },
  {
    "id": 6,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُطَهَّرِ مِنْ كُلِّ آفَةٍ",
    "englishText": "and who is purified from all defects"
  },
  {
    "id": 7,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْبَرِيءِ مِنْ كُلِّ عَيْبٍ",
    "englishText": "and freed from all deficiencies,"
  },
  {
    "id": 8,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُؤَمَّلِ لِلنَّجَاةِ",
    "englishText": "and who is hoped for salvation"
  },
  {
    "id": 9,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُرْتَجَىٰ لِلشَّفَاعَةِ",
    "englishText": "and expected for intercession,"
  },
  {
    "id": 10,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُفَوَّضِ إِلَيْهِ دِينُ ٱللَّهِ",
    "englishText": "and to whom the religion of Allah is delegated."
  },
  {
    "id": 11,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ شَرِّفْ بُنْيَانَهُ",
    "englishText": "O Allah, (please) confer honor upon his structure,"
  },
  {
    "id": 12,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَعَظِّمْ بُرْهَانَهُ",
    "englishText": "ennoble his authority,"
  },
  {
    "id": 13,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَفْلِجْ حُجَّتَهُ",
    "englishText": "make successful his cogency,"
  },
  {
    "id": 14,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱرْفَعْ دَرَجَتَهُ",
    "englishText": "lift up his rank,"
  },
  {
    "id": 15,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَضِئْ نُورَهُ",
    "englishText": "light up his illumination,"
  },
  {
    "id": 16,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَبَيِّضْ وَجْهَهُ",
    "englishText": "make his face glow with whiteness,"
  },
  {
    "id": 17,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَعْطِهِ ٱلْفَضْلَ وَٱلْفَضِيلَةَ",
    "englishText": "grant him merit, virtue,"
  },
  {
    "id": 18,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْمَنْزِلَةَ وَٱلْوَسِيلَةَ",
    "englishText": "[supreme] position, [right of] mediation,"
  },
  {
    "id": 19,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلدَّرَجَةَ ٱلرَّفِيعَةَ",
    "englishText": "and sublime rank,"
  },
  {
    "id": 20,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱبْعَثْهُ مَقَاماً مَحْمُوداً",
    "englishText": "and send him a praiseworthy status"
  },
  {
    "id": 21,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "يَغْبِطُهُ بِهِ ٱلأَوَّلُونَ وَٱلآخِرُونَ",
    "englishText": "which the past and last generations will wish to have."
  },
  {
    "id": 22,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ أَمِيرِ ٱلْمُؤْمِنِينَ",
    "englishText": "And send blessings to `Ali, the Commander of the Believers,"
  },
  {
    "id": 23,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 24,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَقَائِدِ ٱلْغُرِّ ٱلُمحَجَّلِينَ",
    "englishText": "the leader of the white-forehead groups,"
  },
  {
    "id": 25,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَسَيِّدِ ٱلْوَصِيِّينَ",
    "englishText": "the chief of the Prophets’ Successors,"
  },
  {
    "id": 26,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 27,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ ٱلْحَسَنِ بْنِ عَلِيٍّ",
    "englishText": "And send blessings to al-Hasan, the son of `Ali,"
  },
  {
    "id": 28,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 29,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 30,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 31,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ ٱلْحُسَيْنِ بْنِ عَلِيٍّ",
    "englishText": "And send blessings to al-Husayn, the son of `Ali,"
  },
  {
    "id": 32,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 33,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 34,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 35,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ عَلِيِّ بْنِ ٱلْحُسَيْنِ",
    "englishText": "And send blessings to `Ali, the son of al-Husayn,"
  },
  {
    "id": 36,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 37,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 38,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 39,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ مُحَمَّدِ بْنِ عَلِيٍّ",
    "englishText": "And send blessings to Muhammad, the son of `Ali,"
  },
  {
    "id": 40,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 41,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 42,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 43,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ جَعْفَرِ بْنِ مُحَمَّدٍ",
    "englishText": "And send blessings to Ja`far, the son of Muhammad,"
  },
  {
    "id": 44,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 45,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 46,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 47,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ مُوسَىٰ بْنِ جَعْفَرٍ",
    "englishText": "And send blessings to Musa, the son of Ja`far,"
  },
  {
    "id": 48,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 49,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 50,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 51,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ عَلِيِّ بْنِ مُوسَىٰ",
    "englishText": "And send blessings to `Ali, the son of Musa,"
  },
  {
    "id": 52,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 53,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 54,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 55,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ مُحَمَّدِ بْنِ عَلِيٍّ",
    "englishText": "And send blessings to Muhammad, the son of `Ali,"
  },
  {
    "id": 56,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 57,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 58,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 59,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ عَلِيِّ بْنِ مُحَمَّدٍ",
    "englishText": "And send blessings to `Ali, son of Muhammad,"
  },
  {
    "id": 60,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 61,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 62,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 63,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ ٱلْحَسَنِ بْنِ عَلِيٍّ",
    "englishText": "And send blessings to al-Hasan, son of `Ali,"
  },
  {
    "id": 64,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنِينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 65,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلِينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 66,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 67,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ ٱلْخَلَفِ ٱلْهَادِي ٱلْمَهْدِيِّ",
    "englishText": "And send blessings to the Successor, the guide and well-guided,"
  },
  {
    "id": 68,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِمَامِ ٱلْمُؤْمِنينَ",
    "englishText": "the leader of the faithful believers,"
  },
  {
    "id": 69,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَوَارِثِ ٱلْمُرْسَلينَ",
    "englishText": "the inheritor of the Messengers,"
  },
  {
    "id": 70,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَّةِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "and the argument of the Lord of the worlds."
  },
  {
    "id": 71,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ",
    "englishText": "O Allah, send blessings to Muhammad and his Household,"
  },
  {
    "id": 72,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلأَئِمَّةِ ٱلْهَادِينَ",
    "englishText": "the guiding Imams,"
  },
  {
    "id": 73,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْعُلَمَاءِ ٱلصَّادِقِينَ",
    "englishText": "the knowledgeable, the veracious,"
  },
  {
    "id": 74,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلأَبْرَارِ ٱلْمُتَّقِينَ",
    "englishText": "the righteous, the pious,"
  },
  {
    "id": 75,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "دَعَائِمِ دِينِكَ",
    "englishText": "the supports of Your religion,"
  },
  {
    "id": 76,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَرْكَانِ تَوْحِيدِكَ",
    "englishText": "the pillars of the belief in Your Oneness,"
  },
  {
    "id": 77,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَتَرَاجِمَةِ وَحْيِكَ",
    "englishText": "the interpreters of Your Revelation,"
  },
  {
    "id": 78,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحُجَجِكَ عَلَىٰ خَلْقِكَ",
    "englishText": "Your arguments on Your creatures,"
  },
  {
    "id": 79,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخُلَفَائِكَ فِي أَرْضِكَ",
    "englishText": "and Your representatives in Your lands,"
  },
  {
    "id": 80,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلَّذِينَ ٱخْتَرْتَهُمْ لِنَفْسِكَ",
    "englishText": "whom You have chosen for Yourself,"
  },
  {
    "id": 81,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱصْطَفَيْتَهُمْ عَلَىٰ عِبَادِكَ",
    "englishText": "You have preferred over Your servants,"
  },
  {
    "id": 82,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱرْتَضَيْتَهُمْ لِدِينِكَ",
    "englishText": "You have accepted (as directors) of Your religion,"
  },
  {
    "id": 83,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخَصَصْتَهُمْ بِمَعْرِفَتِكَ",
    "englishText": "You have given Your knowledge exclusively,"
  },
  {
    "id": 84,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَجَلَّلْتَهُمْ بِكَرَامَتِكَ",
    "englishText": "shaded with Your honoring,"
  },
  {
    "id": 85,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَغَشَّيْتَهُمْ بِرَحْمَتِكَ",
    "englishText": "covered with Your mercy,"
  },
  {
    "id": 86,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَرَبَّيْتَهُمْ بِنِعْمَتِكَ",
    "englishText": "raised with Your boon,"
  },
  {
    "id": 87,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَغَذَّيْتَهُمْ بِحِكْمَتِكَ",
    "englishText": "fed on Your wisdom,"
  },
  {
    "id": 88,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَلْبَسْتَهُمْ نُورَكَ",
    "englishText": "dressed Your Light,"
  },
  {
    "id": 89,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَرَفَعْتَهُمْ فِي مَلَكُوتِكَ",
    "englishText": "lifted up to Your Sovereignty,"
  },
  {
    "id": 90,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحَفَفْتَهُمْ بِمَلاَئِكَتِكَ",
    "englishText": "encompassed with Your angels,"
  },
  {
    "id": 91,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَشَرَّفْتَهُمْ بِنَبِيِّكَ",
    "englishText": "and honored with Your Prophet,"
  },
  {
    "id": 92,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "صَلَوَاتُكَ عَلَيْهِ وَآلِهِ",
    "englishText": "peace of You be upon him and his Household."
  },
  {
    "id": 93,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَيْهِمْ",
    "englishText": "O Allah, (please) send blessings to Muhammad and upon them"
  },
  {
    "id": 94,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "صلاَةً زَاكِيَةً نَامِيَةً",
    "englishText": "with blessings that are so pure, ever-growing,"
  },
  {
    "id": 95,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "كَثِيرَةً دَائِمَةً طَيِّبَةً",
    "englishText": "opulent, permanent, and good"
  },
  {
    "id": 96,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "لاَ يُحيطُ بِهَا إِلاَّ أَنْتَ",
    "englishText": "that none can comprehend save You,"
  },
  {
    "id": 97,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَلاَ يَسَعُهَا إِلاَّ عِلْمُكَ",
    "englishText": "none can embrace save Your knowledge,"
  },
  {
    "id": 98,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَلاَ يُحْصِيهَا أَحَدٌ غَيْرُكَ",
    "englishText": "and none can count save You."
  },
  {
    "id": 99,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ وَصَلِّ عَلَىٰ وَلِيِّكَ",
    "englishText": "O Allah, and also send blessings to Your Friend"
  },
  {
    "id": 100,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْمُحْيِي سُنَّتَكَ",
    "englishText": "who will restore Your way,"
  },
  {
    "id": 101,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلْقَائِمِ بِأَمْرِكَ",
    "englishText": "rise [to undertake the mission] by Your command,"
  },
  {
    "id": 102,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلدَّاعِي إِلَيْكَ",
    "englishText": "call unto You,"
  },
  {
    "id": 103,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "ٱلدَّليلِ عَلَيْكَ",
    "englishText": "and guide to You."
  },
  {
    "id": 104,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "حُجَّتِكَ عَلَىٰ خَلْقِكَ",
    "englishText": "[He is] Your argument against Your creatures,"
  },
  {
    "id": 105,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخَلِيفَتِكَ فِي أَرْضِكَ",
    "englishText": "Your representative in Your lands,"
  },
  {
    "id": 106,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَشَاهِدِكَ عَلَىٰ عِبَادِكَ",
    "englishText": "and Your witness on Your servants."
  },
  {
    "id": 107,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ أَعِزَّ نَصْرَهُ",
    "englishText": "O Allah, (please) confer upon him with a mighty help,"
  },
  {
    "id": 108,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَمُدَّ فِي عُمْرِهِ",
    "englishText": "extend his lifetime,"
  },
  {
    "id": 109,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَزَيِّنِ ٱلأَرْضَ بِطُولِ بَقَائِهِ",
    "englishText": "and adorn the earth with his long-lasting survival."
  },
  {
    "id": 110,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ ٱكْفِهِ بَغْيَ ٱلْحَاسِدِينَ",
    "englishText": "O Allah, (please) save him from the oppression of the enviers,"
  },
  {
    "id": 111,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَعِذْهُ مِنْ شَرِّ ٱلْكَائِدِينَ",
    "englishText": "protect him against the evils of the plotters,"
  },
  {
    "id": 112,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱزْجُرْ عَنْهُ إِرَادَةَ ٱلظَّالِمِينَ",
    "englishText": "deter the unjust from employing their wills against him,"
  },
  {
    "id": 113,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخَلِّصْهُ مِنْ أَيْدِي ٱلْجَبَّارِينَ",
    "englishText": "and redeem him from the hands (i.e. powers) of the tyrants."
  },
  {
    "id": 114,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ أَعْطِهِ فِي نَفْسِهِ وَذُرِّيَّتِهِ",
    "englishText": "O Allah, (please) grant him, concerning himself, his offspring,"
  },
  {
    "id": 115,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَشِيعَتِهِ وَرَعِيَّتِهِ",
    "englishText": "his partisans, his subjects,"
  },
  {
    "id": 116,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَخَاصَّتِهِ وَعَامَّتِهِ",
    "englishText": "his retinue, his publics,"
  },
  {
    "id": 117,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَعَدُوِّهِ وَجَميعِ أَهْلِ ٱلدُّنْيَا",
    "englishText": "[even] his enemies, and all the inhabitants of this world—"
  },
  {
    "id": 118,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "مَا تُقِرُّ بِهِ عَيْنَهُ",
    "englishText": "[give him] that which delights his eye"
  },
  {
    "id": 119,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَتَسُرُّ بِهِ نَفْسَهُ",
    "englishText": "and entertains his self;"
  },
  {
    "id": 120,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَبَلِّغْهِ أَفْضَلَ مَا أَمَّلَهُ",
    "englishText": "and make him attain the best of that which he desires"
  },
  {
    "id": 121,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "فِي ٱلدُّنْيَا وَٱلآخِرَةِ",
    "englishText": "in this world and the Next Word."
  },
  {
    "id": 122,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ",
    "englishText": "Verily, You have power over all things."
  },
  {
    "id": 123,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ جَدِّدْ بِهِ مَا ٱمَتَحَىٰ مِنْ دِينِكَ",
    "englishText": "O Allah, renew, through him, the features of Your religion that have been eradicated,"
  },
  {
    "id": 124,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "أَحْيِ بِهِ مَا بُدِّلَ مِنْ كِتَابِكَ",
    "englishText": "revive, through him, the instructions of Your Books that have been altered,"
  },
  {
    "id": 125,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَظْهِرْ بِهِ مَا غُيِّرَ مِنْ حُكْمِكَ",
    "englishText": "and manifest, through him, the laws of Your code that have been distorted"
  },
  {
    "id": 126,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "حَتَّىٰ يَعُودَ دِينُكَ بِهِ وَعَلَىٰ يَدَيْهِ",
    "englishText": "so that Your religion, through him and at his hands, will again become"
  },
  {
    "id": 127,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "غَضّاً جَدِيداً",
    "englishText": "fresh, new,"
  },
  {
    "id": 128,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "خَالِصاً مُخْلَصاً",
    "englishText": "pure, sound,"
  },
  {
    "id": 129,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "لاَ شَكَّ فِيهِ وَلاَ شُبْهَةَ مَعَهُ",
    "englishText": "free from any doubt or any spurious matter,"
  },
  {
    "id": 130,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَلاَ بَاطِلَ عِنْدَهُ وَلاَ بِدْعَةَ لَدَيْهِ",
    "englishText": "and lacking any accompanying wrong or heresy."
  },
  {
    "id": 131,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ نَوِّرْ بِنُورِهِ كُلَّ ظُلْمَةٍ",
    "englishText": "O Allah, through his light, light up all darkness,"
  },
  {
    "id": 132,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَهُدَّ بِرُكْنِهِ كُلَّ بِدْعَةٍ",
    "englishText": "through his power, demolish all heresies,"
  },
  {
    "id": 133,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱهْدِمْ بِعِزِّهِ كُلَّ ضَلاَلَةٍ",
    "englishText": "through his might, destroy all items of deviation,"
  },
  {
    "id": 134,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱقْصِمْ بِهِ كُلَّ جَبَّارٍ",
    "englishText": "through him, annihilate all tyrants,"
  },
  {
    "id": 135,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَخْمِدْ بِسَيْفِهِ كُلَّ نَارٍ",
    "englishText": "though his sword, extinguish all fires [of sedition],"
  },
  {
    "id": 136,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَهْلِكْ بِعَدْلِهِ جَوْرَ كُلِّ جَائِرٍ",
    "englishText": "through his justice, terminate the prejudice of all unjust ones,"
  },
  {
    "id": 137,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَجْرِ حُكْمَهُ عَلَىٰ كُلِّ حُكْمٍ",
    "englishText": "make his rule prevail on all systems of rule,"
  },
  {
    "id": 138,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَذِلَّ بِسُلْطَانِهِ كُلَّ سُلْطَانٍ",
    "englishText": "and through his authority, humiliate all other authorities."
  },
  {
    "id": 139,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ أَذِلَّ كُلَّ مَنْ نَاوَاهُ",
    "englishText": "O Allah, (please) put down all those who antagonize him,"
  },
  {
    "id": 140,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَهْلِكْ كُلَّ مَنْ عَادَاهُ",
    "englishText": "wipe out all those who incur the hostility of him,"
  },
  {
    "id": 141,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱمْكُرْ بِمَنْ كَادَهُ",
    "englishText": "exterminate the plots of all those who conspire against him,"
  },
  {
    "id": 142,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱسْتَأْصِلْ مَنْ جَحَدَهُ حَقَّهُ",
    "englishText": "and obliterate all those who deny his right,"
  },
  {
    "id": 143,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱسْتَهَانَ بِأَمْرِهِ",
    "englishText": "belittle his mission,"
  },
  {
    "id": 144,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَسَعَىٰ فِي إِطْفَاءِ نُورِهِ",
    "englishText": "work on extinguishing his light,"
  },
  {
    "id": 145,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَرَادَ إِخْمَادَ ذِكْرِهِ",
    "englishText": "and intend to turn off his reputation."
  },
  {
    "id": 146,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ ٱلْمُصْطَفَىٰ",
    "englishText": "O Allah, (please) send blessings to Muhammad, the Chosen Prophet,"
  },
  {
    "id": 147,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَعَلِيٍّ ٱلْمُرْتَضَىٰ",
    "englishText": "`Ali, the Well-pleased,"
  },
  {
    "id": 148,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَفَاطِمَةَ ٱلزَّهْرَاءِ",
    "englishText": "Fatimah, the Luminous,"
  },
  {
    "id": 149,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْحَسَنِ ٱلرِّضَا",
    "englishText": "al-Hasan, the amicable,"
  },
  {
    "id": 150,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْحُسَيْنِ ٱلْمُصَفَّىٰ",
    "englishText": "al-Husayn, the purified,"
  },
  {
    "id": 151,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَجَميعِ ٱلأَوْصِيَاءِ مَصَابيحِ ٱلدُّجَىٰ",
    "englishText": "and all the Successors, the lanterns of darkness,"
  },
  {
    "id": 152,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَأَعْلاَمِ ٱلْهُدَىٰ",
    "englishText": "the signs of true guidance,"
  },
  {
    "id": 153,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَمَنَارِ التُّقَىٰ",
    "englishText": "the lamps of piety,"
  },
  {
    "id": 154,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْعُرْوَةِ ٱلْوُثْقَىٰ",
    "englishText": "the firmest handle,"
  },
  {
    "id": 155,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْحَبْلِ ٱلْمَتينِ",
    "englishText": "the resolved rope [between Allah and His creatures],"
  },
  {
    "id": 156,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلصِّرَاطِ ٱلْمُسْتَقِيمِ",
    "englishText": "and the straight path."
  },
  {
    "id": 157,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلِّ عَلَىٰ وَلِيِّكَ وَوُلاَةِ عَهْدِكَ",
    "englishText": "And (please) send blessings to Your Friend and the trustees of Your affairs"
  },
  {
    "id": 158,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلأَئِمَّةِ مِنْ وُلْدِهِ",
    "englishText": "and the Imams from his descendants,"
  },
  {
    "id": 159,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَمُدَّ فِي أَعْمَارِهِمْ",
    "englishText": "extend their lifetimes,"
  },
  {
    "id": 160,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَزِدْ فِي آجَالِهِمْ",
    "englishText": "increase their periods of life,"
  },
  {
    "id": 161,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَبَلِّغْهُمْ أَقْصَىٰ آمَالِهِمْ",
    "englishText": "and make them attain the utmost of their expectations"
  },
  {
    "id": 162,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "دِيناً وَدُنْياً وَآخِرَةً",
    "englishText": "in the religion, the world, and the Hereafter."
  },
  {
    "id": 163,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَديرٌ",
    "englishText": "Verily, You have power over all things."
  }
]
