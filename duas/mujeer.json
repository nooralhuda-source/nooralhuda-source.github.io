    "volume": 1,
    "arabicText": "اجِرْنَا مِنَ ٱلنَّارِ يَا مُجِيرُ",
    "englishText": "Keep us safe from the everlasting fire O Giver of Refuge!"
  },
  {
    "id": 265,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "سُبْحَانَكَ يَا ذَٱ الْعِزِّ وَٱلْجَمَالِ",
    "englishText": "Glory be to You. O Lord of Honor and Grace, invoked for blessings."
  },
  {
    "id": 266,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "تَبَارَكْتَ يَا ذَا ٱلْجَبَرُوتِ وَٱلْجَلاَلِ",
    "englishText": "O Lord of Might and Majesty, Glory be to You."
  },
  {
    "id": 267,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "سُبْحَانَكَ لاَ إِلٰهَ إِلاَّ انْتَ",
    "englishText": "There is no god but You."
  },
  {
    "id": 268,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "سُبْحَانَكَ إِنِّي كُنْتُ مِنَ ٱلظَّالِمِينَ",
    "englishText": "“Glory be to You. Verily, I have been a wrongdoer.”"
  },
  {
    "id": 269,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "فَٱسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ ٱلغَمِّ",
    "englishText": "“So We heard his prayer and saved him from the anguish"
  },
  {
    "id": 270,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَكَذٰلِكَ نُنْجِي ٱلْمُؤْمِنِينَ",
    "englishText": "Thus We save believers.”"
  },
  {
    "id": 271,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ سَيِّدِنَا مُحَمَّدٍ وَآلِهِ اجْمَعِينَ",
    "englishText": "Blessings of Allah be on our chief, Muhammad and his Household, one and all."
  },
  {
    "id": 272,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَالَمِينَ",
    "englishText": "(All) praise be to Allah the Lord of the worlds."
  },
  {
    "id": 273,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَحَسْبُنَا ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ",
    "englishText": "Sufficient for us is Allah. He is the Best Protector."
  },
  {
    "id": 274,
    "categoryId": 1,
    "volume": 1,
    "arabicText": "وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ",
    "englishText": "There is no power and no might except (with) Allah, the High, the Great."
  }
]
